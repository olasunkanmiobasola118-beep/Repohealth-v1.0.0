rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateId(id) {
      return id is string && id.size() == 10 && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'olasunkanmiobasola118@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUserMetric(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'provider', 'lastActiveDate', 'registeredAt', 'lastActiveAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'provider', 'lastActiveDate', 'registeredAt', 'lastActiveAt']) &&
        data.uid is string && data.uid == userId && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.provider in ['google', 'email'] &&
        data.lastActiveDate is string && isValidDateId(data.lastActiveDate) &&
        data.registeredAt is timestamp &&
        data.lastActiveAt is timestamp;
    }

    function isValidDailyActivityUser(data, dateId, userId) {
      return data.keys().hasAll(['uid', 'dateKey', 'lastSeenAt']) &&
        data.keys().hasOnly(['uid', 'dateKey', 'lastSeenAt']) &&
        data.uid is string && data.uid == userId && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.dateKey is string && data.dateKey == dateId && isValidDateId(data.dateKey) &&
        data.lastSeenAt is timestamp;
    }

    function isValidAdminRecord(data, adminId) {
      return data.keys().hasAll(['uid', 'email', 'grantedBy', 'grantedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'grantedBy', 'grantedAt']) &&
        data.uid is string && data.uid == adminId && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.grantedBy is string && data.grantedBy == request.auth.uid && data.grantedBy.size() >= 1 && data.grantedBy.size() <= 128 &&
        data.grantedAt is timestamp;
    }

    // Connectivity probe document
    match /test/connection {
      allow get: if isSignedIn();
      allow list, write: if false;
    }

    // Admin allowlist collection
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(adminId) &&
        isValidAdminRecord(incoming(), adminId) &&
        incoming().grantedAt == request.time &&
        isAdmin();
      allow update: if isValidId(adminId) &&
        isValidAdminRecord(incoming(), adminId) &&
        isAdmin() &&
        incoming().uid == existing().uid &&
        incoming().grantedAt == existing().grantedAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'grantedBy']);
      allow delete: if isValidId(adminId) && isAdmin() && adminId != request.auth.uid;
    }

    // User registration & activity metrics (PII isolated to owner or verified admin)
    match /userMetrics/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) &&
        isVerifiedUser() &&
        isValidUserMetric(incoming(), userId) &&
        incoming().registeredAt == request.time &&
        incoming().lastActiveAt == request.time &&
        (
          isAdmin() ||
          (isOwner(userId) && incoming().email == request.auth.token.email)
        );
      allow update: if isValidId(userId) &&
        isVerifiedUser() &&
        isValidUserMetric(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().registeredAt == existing().registeredAt &&
        incoming().lastActiveAt == request.time &&
        (
          isAdmin() ||
          (
            isOwner(userId) &&
            incoming().email == existing().email &&
            incoming().provider == existing().provider &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'lastActiveDate', 'lastActiveAt'])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Daily Active Users subcollection partitioned by UTC YYYY-MM-DD
    match /dailyActivity/{dateId}/users/{userId} {
      allow get: if isValidDateId(dateId) && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isValidDateId(dateId) && isAdmin();
      allow create: if isValidDateId(dateId) &&
        isValidId(userId) &&
        isVerifiedUser() &&
        isValidDailyActivityUser(incoming(), dateId, userId) &&
        incoming().lastSeenAt == request.time &&
        (isOwner(userId) || isAdmin());
      allow update: if isValidDateId(dateId) &&
        isValidId(userId) &&
        isVerifiedUser() &&
        isValidDailyActivityUser(incoming(), dateId, userId) &&
        incoming().uid == existing().uid &&
        incoming().dateKey == existing().dateKey &&
        incoming().lastSeenAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['lastSeenAt']) &&
        (isOwner(userId) || isAdmin());
      allow delete: if isValidDateId(dateId) && isValidId(userId) && isAdmin();
    }
  }
}
