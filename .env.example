# GEMINI_API_KEY: Server-side API key for Gemini AI calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public base URL where the application is hosted.
APP_URL="MY_APP_URL"

# ENCRYPTION_SECRET: Server-side secret used to encrypt stored AI provider & GitHub tokens.
# Must be at least 32 characters in production.
ENCRYPTION_SECRET="CHANGE_ME_TO_A_RANDOM_32_BYTE_SECRET"

# DEEPSEEK_API_KEY: Optional default server-side key for DeepSeek models.
DEEPSEEK_API_KEY=""
